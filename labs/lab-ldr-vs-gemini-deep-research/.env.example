# Copy to .env with scripts/make_env.sh (fills the two generated secrets).

# Password of the lab user LDR registers on first use (generated).
LDR_LAB_PASSWORD=change-me
# Session secret for SearXNG (generated).
SEARXNG_SECRET=change-me
# Contact string SEC and CISA require on requests: your name and email.
SEC_USER_AGENT=Your Name your.email@example.org
# Gemini key for the frontier runs; leave blank to only score committed runs.
GEMINI_API_KEY=
# debug, info, warning or error.
LOG_LEVEL=info

# Optional knobs, shown with their defaults.
# LDR username that bench logs in as.
# LDR_LAB_USERNAME=lab
# Served model name sent to LDR.
# LDR_MODEL=qwen3.6-27b
# Seconds between status polls of an LDR research.
# LDR_POLL_SECONDS=10
# Minutes before an LDR research counts as timed out.
# LDR_TIMEOUT_MINUTES=60
# Model server listing used by `check`.
# MODEL_URL=http://host.docker.internal:8000/v1/models
# GPU instance price used for the cost estimate.
# INSTANCE_PRICE_USD_PER_HOUR=2.8035
# Gemini Deep Research agent id.
# GEMINI_AGENT=deep-research-preview-04-2026
# Gemini API version.
# GEMINI_API_VERSION=v1beta
# Seconds between Gemini status polls.
# GEMINI_POLL_SECONDS=15
# Minutes before a Gemini run counts as timed out.
# GEMINI_TIMEOUT_MINUTES=65
