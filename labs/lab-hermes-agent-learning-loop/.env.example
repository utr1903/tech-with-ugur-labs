# GCP project that serves the Gemini models through Vertex AI.
VERTEX_PROJECT_ID=your-gcp-project

# Shared secret between the harness and Hermes' API server (16+ characters).
# Generate one with: openssl rand -hex 24
API_SERVER_KEY=

# Host user id that owns the Hermes data directory (run: id -u).
HERMES_UID=

# Host group id that owns the Hermes data directory (run: id -g).
HERMES_GID=

# gcloud Application Default Credentials file, created by
# `gcloud auth application-default login`; mounted read-only into the
# Hermes container. Written literally: replace ${HOME} if your shell does not expand it.
ADC_FILE=${HOME}/.config/gcloud/application_default_credentials.json

# Model Hermes must be serving; `check` fails if the session reports another.
# Optional; defaults to google/gemma-4-26b-a4b-it-maas.
HERMES_MODEL=google/gemma-4-26b-a4b-it-maas

# Log verbosity for the harness: debug, info, warning or error.
LOG_LEVEL=info
