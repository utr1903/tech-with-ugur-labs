# Anthropic API key the agent uses for inference (always required).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model the agent runs on.
CLAUDE_MODEL=claude-haiku-4-5

# telegram = live bot via long polling; script = automated verification run.
TRANSPORT=telegram

# Telegram bot token from @BotFather (telegram transport only).
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-here

# Your own numeric chat ID; every other chat is refused (telegram transport only).
TELEGRAM_ALLOWED_CHAT_ID=123456789

# Seed for the deterministic garden simulator.
GARDEN_SEED=42

# pino log level.
LOG_LEVEL=info
