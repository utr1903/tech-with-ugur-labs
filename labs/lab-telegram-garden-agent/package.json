{
  "name": "lab-telegram-garden-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.8",
    "@langchain/core": "1.2.9",
    "grammy": "1.46.0",
    "langchain": "1.5.10",
    "pino": "10.3.1",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.2.0",
    "knip": "6.33.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
