# A label for this workload, used in every log line and in the run summary.
CLIENT_NAME=client-checkout
# The egress gateway. Everything this workload sends to the internet goes here;
# there is no other route out of the workload network.
HTTP_PROXY=http://egress-proxy:3128
# How long the workload keeps making requests before it exits.
RUN_SECONDS=120
# Per-request timeout in milliseconds.
REQUEST_TIMEOUT_MS=10000
# The request mix: comma-separated "<url>@<interval in ms>" entries.
REQUEST_PLAN=http://api.payments.example.com/orders@1000,http://assets.cdn.example.com/bundle.js@20000
# A destination that is deliberately NOT on the gateway's allow-list.
DENIED_URL=http://exfil.shadow-analytics.example.com/collect
# A destination this workload tries to reach directly, going around the gateway.
BYPASS_HOST=payments-direct.example.com
BYPASS_PORT=8080
# pino log level: debug | info | warn | error
LOG_LEVEL=info
