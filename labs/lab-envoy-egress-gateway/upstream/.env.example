# Port this destination listens on inside the lab network.
PORT=8080
# Size in bytes of every response body. This is what makes each destination's
# byte and body-size statistics in Envoy exactly predictable.
PAYLOAD_BYTES=2048
# The FQDN this container answers as, used only for logging.
DESTINATION_NAME=api.payments.example.com
# pino log level: debug | info | warn | error
LOG_LEVEL=info
