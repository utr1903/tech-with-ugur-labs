    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip"
  },
  "dependencies": {
    "pino": "10.3.1",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.2.0",
    "knip": "6.33.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
