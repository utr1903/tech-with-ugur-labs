{
  "name": "lab-envoy-egress-gateway-upstream",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
