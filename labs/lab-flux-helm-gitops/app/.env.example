# HTTP port the service listens on
PORT=3000
# Behavior version: "1" serves body only, "2" also serves author (needs migration 2)
APP_VERSION=1
# Bearer token clients must present (in the cluster this arrives via a SOPS-decrypted Secret)
API_TOKEN=replace-me
# Postgres connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=demo
PGUSER=demo
PGPASSWORD=replace-me
# pino level: debug | info | warn | error
LOG_LEVEL=info
