# Terraform (local state stays on your machine)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
*.tfplan
# Per-deployment SSH host key and fetched run results
.ssh/
results/
node_modules/
# Sample-task fixture logs are real, tracked test data, not run output
# the repo-wide *.log ignore would otherwise swallow them silently.
!tasks/**/*.log
