{
  "name": "tenants",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip"
  },
  "dependencies": {
    "pg": "8.16.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "knip": "6.35.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
