# Runtime settings for the SOC responder (set by the Kubernetes manifests).
LOG_LEVEL=info
PORT=8081
STATE_DIR=/var/lib/soc
RESPONDER_TOKEN=LAB-FAKE-responder-token
ADMIN_TOKEN=LAB-FAKE-admin-token

# Runtime settings for the SOC agent (PORT above is 8080 for the agent).
AGENT_TOKEN=LAB-FAKE-agent-token
RESPONDER_URL=http://responder.soc.svc:8081
LOKI_URL=http://loki.observability.svc:3100
REPORTS_DIR=/var/lib/soc/reports
INVESTIGATION_TOKEN_BUDGET=400000
MAX_ITERATIONS=25
ANTHROPIC_API_KEY=LAB-FAKE-set-your-own-key
