    "lint:fix": "biome check --write .",
    "knip": "knip"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@kubernetes/client-node": "2.0.2",
    "hono": "4.13.22",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "22.19.1",
    "knip": "6.48.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
