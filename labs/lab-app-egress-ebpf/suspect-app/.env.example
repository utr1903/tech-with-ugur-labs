# Log verbosity for the pino logger (debug|info|warn|error)
LOG_LEVEL=info
# The vendor's cert; the app trusts it for its own HTTPS calls (its trust
# decision — NOT an injected interceptor CA).
VENDOR_CERT_PATH=/certs/webhost-cert.pem
# Benign update check (main process)
UPDATE_URL=https://updates.goodvendor.lab/version
# Covert beacons (helper process, comma-separated)
BEACON_URLS=https://cdn-metrics.tracklab.lab/beacon,https://telemetry.adnexus.lab/collect
# The dropped helper binary and the script it runs
HELPER_BIN=/app/bin/sys-helper
HELPER_SCRIPT=/app/src/helper.ts
# Grace period after the last request so the sensor flushes its events
SETTLE_MS=3000
