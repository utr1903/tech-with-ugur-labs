# Endpoints as published by kind's extraPortMappings (see kind/cluster.yaml).
VANILLA_PROM_URL=http://127.0.0.1:30900
THANOS_QUERY_URL=http://127.0.0.1:30903
SHARD0_PROM_URL=http://127.0.0.1:30901
SHARD1_PROM_URL=http://127.0.0.1:30902
GRAFANA_URL=http://127.0.0.1:30904
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme
# Namespace of the sharded install; the failover proof deletes pods here.
THANOS_NAMESPACE=monitoring-thanos
# The Prometheus replica pod the failover proof kills (shard 0, replica 1).
PROM_KILL_POD=prometheus-kps-thanos-prometheus-1
LOG_LEVEL=info
