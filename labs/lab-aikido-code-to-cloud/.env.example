# Your Aikido settings for this lab. Copy it next to this file and fill it in:
#   cp .env.example .env      (.env is gitignored)
# Variables already set in your shell win over this file
# (e.g. AIKIDO_EXTERNAL_ID=aikido-123456 make deploy).

# Aikido REST API client (client credentials).
# Aikido UI: Settings → Integrations → API → REST API → create a client with the scopes
#   clouds:read clouds:write repositories:read repositories:write issues:read
AIKIDO_CLIENT_ID=
AIKIDO_CLIENT_SECRET=

# Name of your private copy of this lab, as Aikido lists it under Repositories.
# `make repo` prints the value to put here; connect that repo in Aikido before `make deploy`.
AIKIDO_REPO_NAME=

# Optional. External ID Aikido presents when it assumes the read-only AWS role.
# Leave it empty: the deploy derives it as aikido-<workspace id> from the Aikido API.
# Only set it if Aikido's AWS connect wizard shows a different value.
AIKIDO_EXTERNAL_ID=
