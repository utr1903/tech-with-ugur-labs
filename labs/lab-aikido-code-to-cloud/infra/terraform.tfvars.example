# Your GCP settings for this lab. Copy it next to this file and fill it in:
#   cp infra/terraform.tfvars.example infra/terraform.tfvars    (*.tfvars is gitignored)
#
# The lab creates two GCP projects (dev and prod) under an organization and
# overrides three org policies on those two projects only. Your Google account
# needs roles/orgpolicy.policyAdmin on the organization, plus permission to
# create projects and link the billing account.

# Organization the lab projects are created under:
#   gcloud organizations list
gcp_org_id = "123456789012"

# Billing account linked to both projects:
#   gcloud billing accounts list
gcp_billing_account = "000000-AAAAAA-000000"

# Your organization's Cloud Identity customer ID. The domain-restricted sharing
# override keeps it allowed next to Aikido's own customer ID:
#   gcloud organizations describe <gcp_org_id> --format='value(owner.directoryCustomerId)'
gcp_own_customer_id = "C00000000"

# Optional overrides (defaults shown):
# gcp_region = "europe-west3"
# gcp_zone   = "europe-west3-a"
