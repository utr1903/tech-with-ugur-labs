{
  "name": "paybuddy-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "export": "tsx scripts/export.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@langchain/aws": "^1.5.2",
    "@langchain/core": "^1.4.2",
    "axios": "0.21.1",
    "cors": "^2.8.6",
    "express": "4.17.1",
    "jsonwebtoken": "8.5.1",
    "langchain": "^1.6.7",
    "lodash": "4.17.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "aws-sdk-client-mock": "^4.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
