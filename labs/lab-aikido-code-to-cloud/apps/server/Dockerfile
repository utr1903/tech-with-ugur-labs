# INSECURE-BY-DESIGN: old, unpinned-by-digest full node:22.13.0 image (not slim, not distroless)
FROM node:22.13.0

# INSECURE-BY-DESIGN: unpinned apt packages, no list cleanup, dev tools (curl, netcat, vim) in the image
RUN apt-get update && apt-get install -y curl netcat-openbsd vim

WORKDIR /app

# INSECURE-BY-DESIGN: ADD of the whole build context (incl. test/ and scripts/) instead of COPY of specific files
ADD . /app

# Dev dependencies are installed and kept in the final image
RUN npm install
RUN npm run build

# INSECURE-BY-DESIGN: fake Stripe live secret key baked into an image ENV layer (generated by `make repo` in your private copy)
ENV STRIPE_KEY=__FAKE_STRIPE_LIVE_KEY__

EXPOSE 8080

# INSECURE-BY-DESIGN: no USER instruction, container runs as root
# INSECURE-BY-DESIGN: no HEALTHCHECK instruction
CMD ["node","dist/index.js"]
