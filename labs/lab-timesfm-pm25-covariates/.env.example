# Where the committed data snapshot is read from.
DATA_DIR=data
# Where forecasts.npz and smog_episode.png are written.
OUTPUT_DIR=tmp
# debug | info | warning | error
LOG_LEVEL=info
# matplotlib renders to a file, never a display.
MPLBACKEND=Agg
# Where the TimesFM checkpoint is cached, so it downloads once.
HF_HOME=/cache/huggingface
