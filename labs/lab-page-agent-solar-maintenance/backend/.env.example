# Logging
LOG_LEVEL=info

# Server
PORT=8080

# Session signing key. Change this outside a lab.
JWT_SECRET=dev-only-secret-change-me

# LLM transport: "scripted" needs no credentials at all; "gemini" needs a key.
LLM_MODE=scripted
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Agent relay budgets
AGENT_CALL_BUDGET=120
AGENT_BUDGET_WINDOW_S=300
AGENT_MAX_REQUEST_BYTES=512000
AGENT_MAX_MESSAGES=8
AGENT_MAX_TOKENS=2048
