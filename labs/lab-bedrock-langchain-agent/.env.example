# Copy to .env to override. Every value has a working default.
# One KEY=value per line; quotes around a value are optional. Compose reads
# every line; make check and make login read AWS_PROFILE and AWS_REGION.
AWS_PROFILE=default
AWS_REGION=us-east-1
APP_PORT=3000
LOG_LEVEL=info
POSTGRES_PASSWORD=shop-local-only
