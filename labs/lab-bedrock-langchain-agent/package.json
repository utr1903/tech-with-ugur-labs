{
  "name": "lab-bedrock-langchain-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "ask": "tsx src/commands/ask.ts",
    "e2e": "tsx e2e/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "tsx": "4.23.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "knip": "6.32.2",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
