{
  "name": "lab-vertex-ai-search-gdrive-sync-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "tsx --env-file-if-exists=.env src/index.ts seed",
    "sync": "tsx --env-file-if-exists=.env src/index.ts sync",
    "ask": "tsx --env-file-if-exists=.env src/index.ts ask",
    "changes": "tsx --env-file-if-exists=.env src/index.ts changes",
    "verify": "tsx --env-file-if-exists=.env src/index.ts verify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip"
  },
  "dependencies": {
    "@google-cloud/discoveryengine": "3.1.0",
    "@googleapis/docs": "10.0.0",
    "@googleapis/drive": "22.0.0",
    "commander": "15.0.0",
    "google-auth-library": "11.0.2",
    "pino": "10.3.1",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.2.0",
    "knip": "6.33.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
