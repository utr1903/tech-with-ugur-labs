{
  "name": "number-publisher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "knip": "knip",
    "lint": "biome check src biome.json knip.json package.json tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/pubsub": "6.0.1",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.20.2",
    "knip": "6.35.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
