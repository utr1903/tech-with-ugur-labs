{
	"name": "voice-rag-backend",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"test": "vitest run --exclude '**/*.integration.test.ts'",
		"test:integration": "vitest run integration.test.ts --no-file-parallelism",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"knip": "knip",
		"db:generate": "drizzle-kit generate",
		"dev": "tsx src/index.ts"
	},
	"dependencies": {
		"@hono/node-server": "1.19.17",
		"drizzle-orm": "0.45.2",
		"hono": "4.13.7",
		"openai": "7.15.0",
		"pg": "8.23.0",
		"pino": "10.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "24.12.0",
		"@types/pg": "8.23.1",
		"drizzle-kit": "0.31.10",
		"knip": "6.35.1",
		"tsx": "4.23.13",
		"typescript": "5.9.3",
		"vitest": "5.0.0"
	}
}
