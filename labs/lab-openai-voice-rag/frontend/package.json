{
	"name": "voice-rag-frontend",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev --hostname 0.0.0.0",
		"build": "next build",
		"start": "next start --hostname 0.0.0.0",
		"test": "vitest run --exclude '**/*.browser.test.ts'",
		"test:browser": "playwright test",
		"browser:install": "playwright install --with-deps chromium",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"knip": "knip",
		"corpus:refresh": "tsx src/commands/refresh-main.ts"
	},
	"dependencies": {
		"next": "16.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"pino": "10.3.1"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@biomejs/biome": "2.5.13",
		"@types/node": "24.12.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"typescript": "5.9.3",
		"vitest": "5.0.0",
		"knip": "6.35.1",
		"tsx": "4.23.13"
	},
	"type": "module"
}
