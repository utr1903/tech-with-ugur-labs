LOG_LEVEL=info
DATABASE_URL=postgresql://executor:replace-me@127.0.0.1:5432/executor
# Host integration tests require BOTH explicit values; deployed code uses in-cluster credentials.
LAB_KUBECONFIG=/absolute/path/to/owned/kubeconfig
LAB_KUBE_CONTEXT=kind-your-owned-lab
# Optional integration checks ONLY: isolated disposable DB; tests reset its execution ledger.
# TEST_DATABASE_URL=postgresql://executor:replace-me@127.0.0.1:55439/executor_test

# Scripted mode is the keyless default; openai requires a backend-only key.
MODEL_MODE=scripted
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=replace-with-your-own-key
SCRIPTED_SCENARIO=conversation
# SCRIPTED_SOURCE=print(6*7)
# Set only in the deployed backend; host mode always binds 127.0.0.1.
IN_CLUSTER=false
# Reader build/smoke commands:
LAB_DOCKER_CONTEXT=default
BACKEND_IMAGE=twu-chat-backend:local
BACKEND_URL=http://127.0.0.1:3001
