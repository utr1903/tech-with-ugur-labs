GVISOR_DOCKER_CONTEXT=desktop-linux
GVISOR_CLUSTER_NAME=gvisor-code-execution
GVISOR_STATE_DIR=/tmp/contained-chat
# Optional override when verifying an already-owned cluster:
GVISOR_KUBECONFIG=/tmp/contained-chat/cache/kubeconfig
GVISOR_EVIDENCE_DIR=/tmp/contained-chat/verification
# Supply securely in the bootstrap environment for OpenAI mode only:
OPENAI_API_KEY=replace-with-your-backend-only-key
