# Log verbosity for the pino logger (debug|info|warn|error)
LOG_LEVEL=info
# Where the mitmproxy CA (trusted for the decryptable calls) is mounted
MITM_CA_PATH=/certs/mitmproxy-ca-cert.pem
# The vendor's real leaf cert, used to pin the "C2" connection
PINNED_CERT_PATH=/certs/webhost-cert.pem
# Benign update check
UPDATE_URL=https://updates.goodvendor.lab/version
# Covert beacons (comma-separated)
BEACON_URLS=https://cdn-metrics.tracklab.lab/beacon,https://telemetry.adnexus.lab/collect
# Certificate-pinned C2 connection
PINNED_URL=https://pin.evil-c2.lab/checkin
# Grace period after the last request so the gateway flushes its capture
SETTLE_MS=2000
